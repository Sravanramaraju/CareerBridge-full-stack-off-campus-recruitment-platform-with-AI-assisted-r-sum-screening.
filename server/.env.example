NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://careerbridge:careerbridge_dev@localhost:5432/careerbridge?schema=public
DATABASE_URL_TEST=postgresql://careerbridge:careerbridge_dev@localhost:5432/careerbridge_test?schema=public
CLIENT_ORIGIN=http://localhost:5173

SESSION_COOKIE_NAME=careerbridge_session
CSRF_COOKIE_NAME=careerbridge_csrf
SESSION_TTL_HOURS=24
REMEMBER_ME_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

LOCAL_STORAGE_PATH=./storage/uploads
MAX_RESUME_SIZE_BYTES=5242880

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerBridge <no-reply@careerbridge.local>

EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=./.cache/models
