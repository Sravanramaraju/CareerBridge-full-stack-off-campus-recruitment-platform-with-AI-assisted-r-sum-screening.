generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  APPLICANT
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  NEEDS_CHANGES
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  RECRUITER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobModerationStatus {
  PENDING
  CLEARED
  FLAGGED
  DEACTIVATED
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum SkillRequirement {
  REQUIRED
  PREFERRED
}

enum StorageProvider {
  LOCAL
  S3
}

enum ResumeParseStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

model User {
  id                       String                     @id @default(cuid())
  email                    String                     @unique
  passwordHash             String
  name                     String
  role                     UserRole
  status                   UserStatus                 @default(ACTIVE)
  lastLoginAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  preference               UserPreference?
  applicantProfile         ApplicantProfile?
  recruiterProfile         RecruiterProfile?
  companyMemberships       CompanyMember[]
  createdJobs              Job[]                      @relation("JobCreator")
  savedJobs                SavedJob[]                 @relation("SavedJobApplicant")
  applications             Application[]              @relation("ApplicationApplicant")
  applicationStatusChanges ApplicationStatusHistory[] @relation("ApplicationStatusActor")
  recruiterNotes           RecruiterNote[]            @relation("RecruiterNoteAuthor")

  @@index([role])
  @@index([status])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  applicationUpdates Boolean  @default(true)
  jobRecommendations Boolean  @default(true)
  careerResources    Boolean  @default(false)
  newApplications    Boolean  @default(true)
  candidateReminders Boolean  @default(true)
  jobExpiryReminders Boolean  @default(true)
  weeklySummary      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicantEducation {
  id                 String           @id @default(cuid())
  applicantProfileId String
  institution        String
  qualification      String
  fieldOfStudy       String?
  startYear          Int?
  endYear            Int?
  isCurrent          Boolean          @default(false)
  grade              String?
  description        String?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model ApplicantProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  headline            String?
  phone               String?
  location            String?
  summary             String?
  preferredLocations  String[]                 @default([])
  preferredJobTypes   String[]                 @default([])
  preferredWorkModes  String[]                 @default([])
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantEducations ApplicantEducation[]
  experiences         ApplicantExperience[]
  projects            ApplicantProject[]
  certifications      ApplicantCertification[]
  skills              ApplicantSkill[]
  resumes             Resume[]
}

model ApplicantExperience {
  id                 String           @id @default(cuid())
  applicantProfileId String
  title              String
  organization       String
  location           String?
  employmentType     String?
  startDate          DateTime?
  endDate            DateTime?
  isCurrent          Boolean          @default(false)
  description        String?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model ApplicantProject {
  id                 String           @id @default(cuid())
  applicantProfileId String
  name               String
  description        String
  projectUrl         String?
  repositoryUrl      String?
  technologies       String[]         @default([])
  startedAt          DateTime?
  completedAt        DateTime?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model ApplicantCertification {
  id                 String           @id @default(cuid())
  applicantProfileId String
  name               String
  issuer             String
  issuedAt           DateTime?
  expiresAt          DateTime?
  credentialId       String?
  credentialUrl      String?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model Skill {
  id             String           @id @default(cuid())
  name           String
  normalizedName String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applicants     ApplicantSkill[]
  jobs           JobSkill[]

  @@index([name])
}

model ApplicantSkill {
  applicantProfileId String
  skillId            String
  proficiency        SkillProficiency?
  yearsExperience    Decimal?          @db.Decimal(4, 1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  applicantProfile   ApplicantProfile  @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)
  skill              Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([applicantProfileId, skillId])
  @@index([skillId])
}

model RecruiterProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  phone     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  description        String?
  website            String?
  industry           String?
  companyType        String?
  size               String?
  foundedYear        Int?
  headquarters       String?
  locations          String[]                  @default([])
  benefits           String[]                  @default([])
  logoUrl            String?
  logoStorageKey     String?
  brandInitials      String?
  brandColor         String?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  members            CompanyMember[]
  jobs               Job[]

  @@index([industry])
  @@index([companyType])
  @@index([verificationStatus])
  @@index([createdAt])
}

model CompanyMember {
  companyId String
  userId    String
  role      CompanyMemberRole @default(RECRUITER)
  joinedAt  DateTime          @default(now())
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
}

model Job {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  companyId          String
  createdByUserId    String
  title              String
  department         String?
  category           String?
  location           String
  workMode           WorkMode
  employmentType     EmploymentType
  openings           Int                    @default(1)
  experienceMin      Int                    @default(0)
  experienceMax      Int                    @default(0)
  salaryMin          Decimal?               @db.Decimal(12, 2)
  salaryMax          Decimal?               @db.Decimal(12, 2)
  currency           String                 @default("INR")
  hideSalary         Boolean                @default(false)
  summary            String
  description        String
  responsibilities   String[]               @default([])
  qualification      String
  contactVisible     Boolean                @default(true)
  featured           Boolean                @default(false)
  status             JobStatus              @default(DRAFT)
  moderationStatus   JobModerationStatus    @default(PENDING)
  deadline           DateTime
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  skills             JobSkill[]
  screeningQuestions JobScreeningQuestion[]
  savedBy            SavedJob[]
  applications       Application[]

  @@index([companyId])
  @@index([createdByUserId])
  @@index([status])
  @@index([moderationStatus])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([deadline])
}

model JobSkill {
  jobId       String
  skillId     String
  requirement SkillRequirement @default(REQUIRED)
  createdAt   DateTime         @default(now())
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([jobId, skillId])
  @@index([skillId])
  @@index([requirement])
}

model JobScreeningQuestion {
  id        String                       @id @default(cuid())
  jobId     String
  question  String
  sortOrder Int
  required  Boolean                      @default(false)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  job       Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers   ApplicationScreeningAnswer[]

  @@unique([jobId, sortOrder])
  @@index([jobId])
}

model Resume {
  id                 String            @id @default(cuid())
  applicantProfileId String
  originalFileName   String
  storageProvider    StorageProvider   @default(LOCAL)
  storageKey         String            @unique
  mimeType           String
  fileSize           Int
  isPrimary          Boolean           @default(false)
  parseStatus        ResumeParseStatus @default(PENDING)
  extractedText      String?
  parsedData         Json?
  parseError         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  applicantProfile   ApplicantProfile  @relation(fields: [applicantProfileId], references: [id], onDelete: Restrict)
  applications       Application[]

  @@index([applicantProfileId])
  @@index([applicantProfileId, isPrimary])
  @@index([parseStatus])
  @@index([deletedAt])
}

model SavedJob {
  applicantId String
  jobId       String
  createdAt   DateTime @default(now())
  applicant   User     @relation("SavedJobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([applicantId, jobId])
  @@index([applicantId, createdAt])
  @@index([jobId])
}

model Application {
  id               String                       @id @default(cuid())
  applicantId      String
  jobId            String
  resumeId         String
  coverNote        String?
  status           ApplicationStatus            @default(APPLIED)
  appliedAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  applicant        User                         @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  job              Job                          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resume           Resume                       @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  screeningAnswers ApplicationScreeningAnswer[]
  statusHistory    ApplicationStatusHistory[]
  match            ApplicationMatch?
  recruiterNotes   RecruiterNote[]

  @@unique([applicantId, jobId])
  @@index([applicantId])
  @@index([jobId])
  @@index([resumeId])
  @@index([status])
  @@index([appliedAt])
}

model ApplicationScreeningAnswer {
  id               String               @id @default(cuid())
  applicationId    String
  questionId       String
  questionSnapshot String
  answer           String
  createdAt        DateTime             @default(now())
  application      Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question         JobScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, questionId])
  @@index([questionId])
}

model ApplicationStatusHistory {
  id              String             @id @default(cuid())
  applicationId   String
  previousStatus  ApplicationStatus?
  newStatus       ApplicationStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime           @default(now())
  application     Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy       User?              @relation("ApplicationStatusActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([changedByUserId])
}

model ApplicationMatch {
  id                     String      @id @default(cuid())
  applicationId          String      @unique
  overallScore           Int
  requiredSkillScore     Int
  preferredSkillScore    Int
  experienceScore        Int
  preferenceScore        Int
  semanticScore          Int?
  semanticAvailable      Boolean     @default(false)
  requiredSkillsMatched  String[]    @default([])
  requiredSkillsMissing  String[]    @default([])
  preferredSkillsMatched String[]    @default([])
  explanation            Json
  modelVersion           String?
  calculatedAt           DateTime    @default(now())
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([overallScore])
  @@index([calculatedAt])
}

model RecruiterNote {
  id            String      @id @default(cuid())
  applicationId String
  authorUserId  String
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User        @relation("RecruiterNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([authorUserId])
}
