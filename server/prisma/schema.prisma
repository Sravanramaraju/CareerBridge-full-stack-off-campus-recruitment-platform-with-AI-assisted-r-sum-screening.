generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  APPLICANT
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  NEEDS_CHANGES
  REJECTED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  preference          UserPreference?
  applicantProfile    ApplicantProfile?
  recruiterProfile    RecruiterProfile?

  @@index([role])
  @@index([status])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  applicationUpdates Boolean  @default(true)
  jobRecommendations Boolean  @default(true)
  careerResources    Boolean  @default(false)
  newApplications    Boolean  @default(true)
  candidateReminders Boolean  @default(true)
  jobExpiryReminders Boolean  @default(true)
  weeklySummary      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicantEducation {
  id                 String           @id @default(cuid())
  applicantProfileId String
  institution        String
  qualification      String
  fieldOfStudy       String?
  startYear          Int?
  endYear            Int?
  isCurrent          Boolean          @default(false)
  grade              String?
  description        String?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model ApplicantProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  headline            String?
  phone               String?
  location            String?
  summary             String?
  preferredLocations  String[]                 @default([])
  preferredJobTypes   String[]                 @default([])
  preferredWorkModes  String[]                 @default([])
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantEducations ApplicantEducation[]
  experiences         ApplicantExperience[]
  projects            ApplicantProject[]
  certifications      ApplicantCertification[]
  skills              ApplicantSkill[]
}

model ApplicantExperience {
  id                 String           @id @default(cuid())
  applicantProfileId String
  title              String
  organization       String
  location           String?
  employmentType     String?
  startDate          DateTime?
  endDate            DateTime?
  isCurrent          Boolean          @default(false)
  description        String?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model ApplicantProject {
  id                 String           @id @default(cuid())
  applicantProfileId String
  name               String
  description        String
  projectUrl         String?
  repositoryUrl      String?
  technologies       String[]         @default([])
  startedAt          DateTime?
  completedAt        DateTime?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model ApplicantCertification {
  id                 String           @id @default(cuid())
  applicantProfileId String
  name               String
  issuer             String
  issuedAt           DateTime?
  expiresAt          DateTime?
  credentialId       String?
  credentialUrl      String?
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId, displayOrder])
}

model Skill {
  id             String           @id @default(cuid())
  name           String
  normalizedName String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applicants     ApplicantSkill[]

  @@index([name])
}

model ApplicantSkill {
  applicantProfileId String
  skillId            String
  proficiency        SkillProficiency?
  yearsExperience    Decimal?          @db.Decimal(4, 1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  applicantProfile   ApplicantProfile  @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)
  skill              Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([applicantProfileId, skillId])
  @@index([skillId])
}

model RecruiterProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  phone     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  description        String?
  website            String?
  industry           String?
  companyType        String?
  size               String?
  foundedYear        Int?
  headquarters       String?
  locations          String[]                  @default([])
  benefits           String[]                  @default([])
  logoUrl            String?
  logoStorageKey     String?
  brandInitials      String?
  brandColor         String?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([industry])
  @@index([companyType])
  @@index([verificationStatus])
  @@index([createdAt])
}
